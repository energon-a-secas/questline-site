---
config:
  theme: base
  themeVariables:
    primaryColor: "#0f172a"
    primaryTextColor: "#e2e8f0"
    primaryBorderColor: "#0063e5"
    lineColor: "#38bdf8"
    secondaryColor: "#1e293b"
    tertiaryColor: "#1e293b"
    clusterBkg: "#f0f7ff"
    clusterBorder: "#bfdbfe"
    edgeLabelBackground: "#e8f0ff"
    mainBkg: "#0f172a"
    nodeBorder: "#0063e5"
    titleColor: "#1e1b4b"
    fontFamily: "ui-sans-serif, system-ui, -apple-system, sans-serif"
    fontSize: "13px"
---
flowchart TB
    User([User]) --> HTML["index.html\nApp shell + quick-menu overlay"]

    subgraph App["ES Modules"]
        HTML --> app["app.js\nEntry point"]
        app --> state["state.js\nRouting + unlock + cursor state"]
        app --> render["render.js\nView dispatcher + flowchart wires"]
        app --> events["events.js\nClicks + surgical toggles"]
        app --> keynav["keynav.js\nArrows, Enter, Q/E tabs"]
        app --> quick["quickmenu.js\nHold-Esc radial menu"]
        app --> splash["splash.js\nBoot splash (press any key)"]
        app --> coach["coach.js\nFirst-run coach-mark"]
        render --> console["console.js\nNieR tab views + chrome helpers"]
        render --> flow["flow.js\nFlow: reveal map + focus map"]
        render --> glossary["glossary.js\nJargon tooltips (gated to decrypted terms)"]
        flow --> console
        flow --> state
        console --> splash
        console --> data["data.js\nChapters, tabs, glossary, ranks"]
        render --> data
        state --> data
        console --> utils["utils.js\nescHtml, toast, action toast"]
        events --> render
        events --> console
        events --> celebrate["celebrate.js\nRank-up, XP, intel-decrypted toast"]
        events --> glossary
        events --> modal["modal.js\nConfirm dialog + focus trap"]
        events --> splash
        events --> kiwi["kiwi.js\nEaster egg"]
        keynav --> render
        keynav --> state
        keynav --> coach
        keynav --> splash
        quick --> modal
        quick --> coach
        quick --> splash
        splash --> coach
        glossary --> state
    end

    state <-->|"questline-v1"| Storage[("localStorage")]
    splash <-->|"questline-splash"| Storage
    events <-->|"#tab / #chapter / #intel/&lt;id&gt; / #flow / #flow/&lt;id&gt;"| Hash["URL hash route"]
    quick -->|"set #section"| Hash
    keynav -->|"set #section"| Hash
